# Copy to .env and change the keys. .env is gitignored.
# docker compose reads this file automatically; the API reads the same names from the environment.

# Used by docker compose for the Postgres container and the API's connection string.
POSTGRES_USER=vergeo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vergeo_reports

# Sent by the Vergeo app (or curl) on POST /reports, header X-API-Key.
INGEST_API_KEY=change-me-ingest
# Sent by the developer on list/query/PATCH/raw endpoints, header X-API-Key.
ADMIN_API_KEY=change-me-admin

# Only needed when running the API outside docker compose:
# DATABASE_URL=postgresql+psycopg://vergeo:change-me@localhost:5432/vergeo_reports
# MAX_UPLOAD_BYTES=4194304
